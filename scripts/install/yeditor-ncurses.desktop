[Desktop Entry]
Name=Yeditor
Comment=Common Lisp editor/IDE with high expansibility
Exec=/usr/local/bin/yeditor %F
MimeType=text/english;text/plain;text/x-makefile;text/x-c++hdr;text/x-c++src;application/x-shellscript;text/x-c;text/x-c++;
Icon=yeditor
Terminal=true
Type=Application
Categories=Development;TextEditor;
